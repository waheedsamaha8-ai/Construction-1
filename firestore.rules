rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /market_data/{docId} {
      allow read, write: if true;
    }
    match /projects/{projectId} {
      allow read, write: if true;
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
